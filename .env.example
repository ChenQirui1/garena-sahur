# Required environment variables without real API credentials.
# Owner: Jerome & Richard

# Development HTTP intake bind address.
SPOTLIGHT_HOST=127.0.0.1
SPOTLIGHT_PORT=8000

# Uvicorn log level: critical, error, warning, info, debug, trace.
SPOTLIGHT_LOG_LEVEL=info

# Largest candidate set accepted in one world snapshot.
SPOTLIGHT_MAX_SNAPSHOT_CANDIDATES=128

# Operational state. Created automatically; defaults to ~/.spotlight/spotlight.sqlite3 so it
# never lands in the checkout.
SPOTLIGHT_DATABASE_PATH=

# Backend-owned NPC persona document.
SPOTLIGHT_NPC_PROFILES_PATH=data/npc_profiles.json

# How long Minecraft may still apply a published behaviour command.
SPOTLIGHT_COMMAND_LIFETIME_MS=15000

# Deterministic stand-in for a tokenizer while no issue scopes one.
SPOTLIGHT_CHARACTERS_PER_TOKEN=4

# Bounded context budgets per tier.
SPOTLIGHT_FOCUSED_INPUT_TOKEN_LIMIT=2000
SPOTLIGHT_FOCUSED_OUTPUT_TOKEN_LIMIT=120
SPOTLIGHT_FOCUSED_HISTORY_TURNS=8
SPOTLIGHT_REACTIVE_INPUT_TOKEN_LIMIT=600
SPOTLIGHT_REACTIVE_OUTPUT_TOKEN_LIMIT=40
