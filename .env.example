# Required environment variables without real API credentials.
# Owner: Jerome & Richard

# Development HTTP intake bind address.
SPOTLIGHT_HOST=127.0.0.1
SPOTLIGHT_PORT=8000

# Uvicorn log level: critical, error, warning, info, debug, trace.
SPOTLIGHT_LOG_LEVEL=info

# Operational state. Created automatically; defaults to ~/.spotlight/spotlight.sqlite3 so it
# never lands in the checkout. Leave commented out to take that default: an empty value here
# resolves to the current directory, which is not a usable database path.
# SPOTLIGHT_DATABASE_PATH=/absolute/path/to/spotlight.sqlite3

# Backend-owned NPC persona document.
SPOTLIGHT_NPC_PROFILES_PATH=data/npc_profiles.json

# How long Minecraft may still apply a published behaviour command. Kept below the mod's own
# 15,000 ms so that an event-triggered command's whole retry window closes while the mod still
# considers the event current — it measures that window from event publish, we measure ours from
# generation. See the derivation in backend/config.py.
SPOTLIGHT_COMMAND_LIFETIME_MS=10000

# Backend-owned cached and scripted fallback dialogue.
SPOTLIGHT_CACHED_DIALOGUE_PATH=data/cached_dialogue.json

# One attempt per tier gets this long; nothing retries it — not the OpenAI SDK, which is
# constructed with automatic retries switched off, and not orchestration, which treats a spent
# attempt as spent and answers from the fallback library instead.
# Reactive matches Focused rather than halving it: measured live, the cheaper model is not the
# faster one — its median and tail both track the strong model's — so a two-second budget spent
# roughly one background line in ten on cached fallback instead of generated dialogue (issue #66).
SPOTLIGHT_FOCUSED_TIMEOUT_MS=4000
SPOTLIGHT_REACTIVE_TIMEOUT_MS=4000

# Which adapter answers a generation request: `mock` or `openai`. Mock is deterministic, needs no
# secret, and is the default, so development, rehearsal and the owned suite never depend on
# external model availability or spend money. Set this to `openai` for a live demo run.
SPOTLIGHT_PROVIDER_MODE=mock

# The configured models each tier reaches in `openai` mode. Only read in `openai` mode.
SPOTLIGHT_FOCUSED_MODEL=gpt-5.6-terra
SPOTLIGHT_REACTIVE_MODEL=gpt-5.6-luna

# Reasoning effort for both tiers: none, minimal, low, medium, high, xhigh, or max. `none` is
# disabled, which is what the spec asks for and what every demo should run — the four- and
# two-second tier budgets assume it. Raise it only if rehearsal shows a tier needs it, and expect
# to revisit those budgets if you do. Leaving it empty is not the same as `none`: it omits the
# setting and takes whatever the model does by default.
SPOTLIGHT_REASONING_EFFORT=none

# Required in `openai` mode and read nowhere else. Left empty here on purpose: this file is
# tracked, so a real key must never be written into it. Put yours in the untracked `.env`.
# Without it, `openai` mode starts, answers liveness, and reports itself *not ready* — it does
# not crash, and it does not quietly fall back to calling nothing.
# SPOTLIGHT_OPENAI_API_KEY=

# Publication retry cadence, repeated while the command is inside its lifetime.
SPOTLIGHT_PUBLICATION_RETRY_DELAYS_MS=[100,250,500,1000]

# Provider call concurrency caps, distinct from the Router's own tier capacities.
SPOTLIGHT_FOCUSED_CONCURRENCY=2
SPOTLIGHT_REACTIVE_CONCURRENCY=6
SPOTLIGHT_TOTAL_CONCURRENCY=8

# Event-geometry radii: witness membership freezes at event start within this range; nearby
# spans from there out to the second radius.
SPOTLIGHT_WITNESS_RADIUS_BLOCKS=12.0
SPOTLIGHT_NEARBY_RADIUS_BLOCKS=24.0

# Deterministic stand-in for a tokenizer while no issue scopes one.
SPOTLIGHT_CHARACTERS_PER_TOKEN=4

# Bounded context budgets per tier.
SPOTLIGHT_FOCUSED_INPUT_TOKEN_LIMIT=2000
SPOTLIGHT_FOCUSED_OUTPUT_TOKEN_LIMIT=120
SPOTLIGHT_FOCUSED_HISTORY_TURNS=8
SPOTLIGHT_REACTIVE_INPUT_TOKEN_LIMIT=600
SPOTLIGHT_REACTIVE_OUTPUT_TOKEN_LIMIT=40

# Development compatibility bridge for the shipped Fabric mod's prototype wire. Serves the mod's
# own `POST /api/v1/messages` and `ws /api/v1/ws?session_id=...`, translates its payloads into
# canonical messages, and sends behaviour commands back over the socket. Off by default: it is a
# deliberate departure from the deployment boundary and it retires at issue #11. Turn it on for a
# demo run against Minecraft; leave it off everywhere else.
# SPOTLIGHT_PROTOTYPE_BRIDGE_ENABLED=true

# What the mod's snapshots do not carry and the canonical contract requires. The radii are the
# mod's own `SpotlightConfig` constants; the world is a stand-in until the mod sends a dimension
# key. Only read when the bridge above is enabled.
SPOTLIGHT_PROTOTYPE_WORLD_ID=minecraft-overworld
SPOTLIGHT_PROTOTYPE_ENTRY_RADIUS_BLOCKS=24.0
SPOTLIGHT_PROTOTYPE_EXIT_RADIUS_BLOCKS=28.0
